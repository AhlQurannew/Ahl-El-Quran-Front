# Copy this file to `.env.local` and adjust. Restart `npm run dev` after changes.
#
# Backend API base URL (must include /api/v1).
# The port must match BACKEND_PORT in AhlQuran-Back/.env (docker-compose
# publishes the backend on http://localhost:${BACKEND_PORT}, default 8000).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
